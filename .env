VITE_KAFKA_LAG_THRESHOLD=1000

# ─── API layer ────────────────────────────────────────────────
# When true (default), the app uses the in-memory mock services.
# Set to false to point the app at the real backend defined by VITE_API_BASE_URL.
VITE_USE_MOCK=true

# Base URL for the real backend (only used when VITE_USE_MOCK=false).
# Example: VITE_API_BASE_URL=https://api.metro.internal/v1
VITE_API_BASE_URL=
